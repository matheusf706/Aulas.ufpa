Algoritmo "semnome"

Var
   dividendo, divisor, quociente, temp_dividendo : inteiro
Inicio
   escreva("Digite o dividendo: ")
   leia(dividendo)

   escreva("Digite o divisor: ")
   leia(divisor)
   se divisor = 0 entao
      escreval("Erro: Divisão por zero não é permitida.")
   senao
      quociente <- 0
      temp_dividendo <- dividendo

      enquanto temp_dividendo >= divisor faca
         temp_dividendo <- temp_dividendo - divisor
         quociente <- quociente + 1
      fimenquanto

      escreval("O quociente inteiro da divisão é: ", quociente)
   fimse
Fimalgoritmo
