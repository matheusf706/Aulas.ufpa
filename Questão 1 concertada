maior_ouro = -1.0
dia_maior = ""

for i in range(7):
    quantidade = float(input("Quantia de ouro: "))
    
    if i == 0:
        dia_atual = "domingo"
    elif i == 1:
        dia_atual = "segunda"
    elif i == 2:
        dia_atual = "terça"
    elif i == 3:
        dia_atual = "quarta"
    elif i == 4:
        dia_atual = "quinta"
    elif i == 5:
        dia_atual = "sexta"
    else:
         dia_atual = "sabado"

    if quantidade > maior_ouro:
        maior_ouro = quantidade
        dia_maior = dia_atual

print(dia_maior)
print(f"Quantidade: {maior_ouro}kg")
