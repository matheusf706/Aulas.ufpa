int main(){
    int a, b, c;
    double p, area;
    
    cout <<"Lados do triângulo:\n";
    cin >> a>> b>> c;
    
    p = (a + b + c) / 2;
    area = sqrt(p*(p-a)*(p-b)*(p-c));
    
    cout <<"A area é: " << area << endl;
    return 0;
}
